<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to appsettings.local.config (same folder) and fill in your own values.
  appsettings.local.config is git-ignored, so your passwords never get committed.
  Any key left empty falls back to App.config.
-->
<appSettings>
  <add key="Server" value="localhost" />
  <add key="Port" value="3306" />
  <add key="User" value="tms_app" />
  <add key="Password" value="change-me" />
  <add key="DatabaseName" value="tms" />

  <add key="CMPServer" value="localhost" />
  <add key="CMPPort" value="3306" />
  <add key="CMPUser" value="tms_app" />
  <add key="CMPPassword" value="change-me" />
  <add key="CMPDatabaseName" value="cmp" />
</appSettings>
