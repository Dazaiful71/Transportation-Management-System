<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Transportation_Management_System</RootNamespace>
    <AssemblyName>Transportation Management System</AssemblyName>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Product>Transportation Management System</Product>
    <Description>Freight transportation management for Ontario carriers (WPF, .NET 8, MySQL).</Description>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the test project reach internal types such as Planner. -->
    <InternalsVisibleTo Include="UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="MySql.Data" Version="8.4.0" />
    <PackageReference Include="MySqlBackup.NET" Version="2.3.8" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="favicon.ico" />
    <Resource Include="Views\favicon.png" />
    <Resource Include="Views\logo_white.png" />
    <None Include="img\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.local.example.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.local.config" Condition="Exists('appsettings.local.config')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
