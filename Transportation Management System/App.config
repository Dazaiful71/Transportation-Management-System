<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Connection details are intentionally left blank so no credentials live in source control.
    Fill them in using ONE of these (highest priority first):
      1. Environment variables: TMS_SERVER, TMS_PORT, TMS_USER, TMS_PASSWORD, TMS_DATABASENAME,
         TMS_CMPSERVER, TMS_CMPPORT, TMS_CMPUSER, TMS_CMPPASSWORD, TMS_CMPDATABASENAME
      2. appsettings.local.config next to the executable
         (copy appsettings.local.example.config and edit it; the file is git-ignored)
      3. The values below (the Admin page also writes here)
  -->
  <appSettings>
    <add key="LogFileName" value="tms.log" />
    <add key="LogDirectory" value="" />

    <!-- TMS database -->
    <add key="Server" value="" />
    <add key="Port" value="3306" />
    <add key="User" value="" />
    <add key="Password" value="" />
    <add key="DatabaseName" value="tms" />

    <!-- Contract Marketplace database (read-only source of new contracts) -->
    <add key="CMPServer" value="" />
    <add key="CMPPort" value="3306" />
    <add key="CMPUser" value="" />
    <add key="CMPPassword" value="" />
    <add key="CMPDatabaseName" value="cmp" />
  </appSettings>
</configuration>
